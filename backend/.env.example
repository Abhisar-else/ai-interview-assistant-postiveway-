# Backend Environment Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/interview_simulator
JWT_SECRET=replace_with_output_of__python -c "import secrets; print(secrets.token_hex(32))"
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM provider — set ONE of these (OpenAI preferred, Gemini as fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=

# File storage
RESUME_UPLOAD_DIR=./uploads/resumes

# CORS
FRONTEND_ORIGIN=http://localhost:5173
